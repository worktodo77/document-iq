# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
# Root-anchored. Unanchored, `build/` also ignores docs/build/ — which silently
# swallowed the packaging documentation on its first commit. setuptools only
# ever writes these at the repository root.
/build/
/dist/
.venv/
venv/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# PyInstaller. packaging/DocumentIQ.spec is COMMITTED — it is the reproducible
# half of the build. Only its outputs are ignored.
*.spec.bak
build_out/

# Track F verification runs write measured output here; the notes are committed,
# the raw runs are not (they contain client file names).
verification_runs/

# OS
Thumbs.db
Desktop.ini

# Matter data — NEVER commit client documents or outputs
matter_data/
test_matters/
*.msg
*.eml

# Generated fixture corpus — rebuilt by tests/fixtures/make_fixtures.py
tests/fixtures/generated/
